# Caddy drops an incoming X-Forwarded-For unless the peer is a trusted proxy, so without this the
# backend sees every request as coming from nginx on LC2 and all users share one rate-limit
# bucket. Trust ONLY LC2 (static 192.168.40.11): any other host on the VLAN that connects to this
# port directly still has its X-Forwarded-For discarded, so client IPs can't be spoofed.
# Chain: Cloudflare edge -> cloudflared (LC2, 127.0.0.1) -> nginx (LC2) -> Caddy -> backend,
# which is why the backend runs with TRUST_PROXY_HOPS=3.
{
  servers {
    trusted_proxies static 192.168.40.11/32
  }
}

# connect-src https: — presigned PUTs go straight to the MinIO hostname.
# img-src https: — presigned GETs for item photos and thumbnails.
# Kept as a snippet because Caddy applies only ONE matching `header` directive per request, so
# each handle block needs its security headers and its Cache-Control set together.
(security_headers) {
  X-Content-Type-Options "nosniff"
  Referrer-Policy "strict-origin-when-cross-origin"
  X-Frame-Options "DENY"
  Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; style-src 'self' 'unsafe-inline'; connect-src 'self' https:; media-src 'self' blob:; worker-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
}

:80 {
  encode gzip zstd

  handle /api/* {
    header {
      X-Content-Type-Options "nosniff"
      Referrer-Policy "strict-origin-when-cross-origin"
      X-Frame-Options "DENY"
    }
    reverse_proxy backend:3000
  }

  # Hashed build output is immutable: its name changes whenever the bytes do.
  handle /assets/* {
    root * /srv
    header {
      import security_headers
      Cache-Control "public, max-age=31536000, immutable"
    }
    file_server
  }

  # Everything else is either the service worker, the manifest, or index.html served under an
  # app route by the SPA fallback — all of which must revalidate, or clients get stranded on an
  # old build. (The previous matcher only covered the literal /index.html, so every app route
  # such as /h/abc/shopping was served cacheable.)
  handle {
    root * /srv
    header {
      import security_headers
      Cache-Control "no-cache"
    }
    try_files {path} /index.html
    file_server
  }
}
